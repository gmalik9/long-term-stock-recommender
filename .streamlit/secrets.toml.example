# Copy this to .streamlit/secrets.toml locally, or paste these keys into
# Streamlit Cloud → App settings → Secrets when deploying.
# Only FINNHUB_API_KEY is strictly required; the others are optional and
# the app no-ops gracefully if a key is missing.

FINNHUB_API_KEY = "your_finnhub_key_here"
ALPHAVANTAGE_API_KEY = "your_alphavantage_key_here"

# Optional extra news sources
MARKETAUX_API_KEY = "..."
NEWSAPI_KEY = "..."
TIINGO_API_KEY = "..."

# Optional Reddit (requires script-type app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID = "..."
REDDIT_CLIENT_SECRET = "..."
REDDIT_USER_AGENT = "stock-recommender/0.1 by u/yourname"
