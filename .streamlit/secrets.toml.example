# Copy this to .streamlit/secrets.toml locally, or paste these keys into
# Streamlit Cloud → App settings → Secrets when deploying.
# Only FINNHUB_API_KEY is strictly required; the others are optional and
# the app no-ops gracefully if a key is missing.

FINNHUB_API_KEY = "your_finnhub_key_here"
ALPHAVANTAGE_API_KEY = "your_alphavantage_key_here"

# Optional extra news sources
MARKETAUX_API_KEY = "..."
NEWSAPI_KEY = "..."
TIINGO_API_KEY = "..."

# Optional Reddit (requires script-type app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID = "..."
REDDIT_CLIENT_SECRET = "..."
REDDIT_USER_AGENT = "stock-recommender/0.1 by u/yourname"

# ─────────────────────────────────────────────────────────────
# Alpaca Paper Trading (Phase 9 — Agent MCP surface only)
# ─────────────────────────────────────────────────────────────
# Sign up at https://alpaca.markets/ → "Paper Trading" → generate API keys.
# These keys must be PAPER keys. Live keys will be REFUSED by the broker layer.
ALPACA_API_KEY_ID = "PK..."
ALPACA_SECRET_KEY = "..."
ALPACA_PAPER = "true"                       # must be literal "true"

# Agent trading is OFF by default. Set to "true" to allow MCP write tools
# (place_order, cancel_order, close_position, rebalance_to_recommendations).
STOCK_REC_MCP_TRADING_ENABLED = "false"
STOCK_REC_MAX_ORDER_USD = "1000"            # per-order notional cap
STOCK_REC_MAX_SYMBOL_PCT = "20"             # per-symbol % of equity cap

